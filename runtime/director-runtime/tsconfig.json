{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "outDir": "dist",
    "rootDir": "src",
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@earendil-works/pi-agent-core": ["dist/node_modules/@earendil-works/pi-agent-core/dist/index.d.ts"],
      "@earendil-works/pi-ai": ["dist/node_modules/@earendil-works/pi-ai/dist/index.d.ts"],
      "@earendil-works/pi-telemetry": ["dist/node_modules/@earendil-works/pi-telemetry/dist/index.d.ts"]
    }
  },
  "include": ["src/**/*.ts"]
}
