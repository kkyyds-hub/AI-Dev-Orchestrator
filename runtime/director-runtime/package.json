{
  "name": "@ai-dev-orchestrator/director-runtime",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "workspaces": [
    "upstream/pi/packages/telemetry",
    "upstream/pi/packages/ai",
    "upstream/pi/packages/agent"
  ],
  "scripts": {
    "verify:upstream": "node scripts/verify-upstream.mjs",
    "verify:pi-core-build": "node scripts/verify-pi-core-build.mjs",
    "test": "node --test tests/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "prepare:pi-core-runtime": "DIRECTOR_RUNTIME_PREPARE_OUTPUT=dist/node_modules node scripts/verify-pi-core-build.mjs",
    "build": "npm run prepare:pi-core-runtime && tsc",
    "probe": "node dist/probe.js",
    "director-runtime": "node dist/director-runtime.js"
  }
}
